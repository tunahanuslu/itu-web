# ==============================================================================
# İTÜ Web Alanı - Askeri Düzey Sunucu Sertleştirme ve PWA Mimarisi
# ==============================================================================

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

FileETag MTime Size

# PWA Manifest MIME Türü Standardı
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
    Header append Vary Accept-Encoding
</IfModule>

<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"

    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Resource-Policy "same-origin"
    Header set X-Permitted-Cross-Domain-Policies "none"

    # CSP Level 3: worker-src 'self' ile Service Worker zırhı
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self';"

    # HTML, Service Worker ve Manifest: Asla önbelleğe alma
    <FilesMatch "\.(html|htm|webmanifest)$|^sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # Statik Varlıklar (CSS, SVG, WOFF2, ICO, diğer JS): 1 Hafta Önbellekle
    <FilesMatch "\.(css|svg|woff2|ico)$|^telemetry\.js$|^loom\.js$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>
</IfModule>

<FilesMatch "(^\.|\.(bak|config|sql|ini|log|sh|py|md)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

ErrorDocument 404 /usluy26/404.html
