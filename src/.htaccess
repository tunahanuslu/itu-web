# ==============================================================================
# İTÜ Web Alanı - Sunucu Sertleştirme ve Yüksek Performans Yapılandırması
# ==============================================================================

# 1. Dizin Gezinmesini (Directory Listing) Kesin Olarak Kapat
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# 2. GZIP / DEFLATE Sıkıştırması (Ağ Trafiğini %70-80 Azaltır)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    Header append Vary Accept-Encoding
</IfModule>

# 3. Güvenlik Başlıkları (Security Headers)
<IfModule mod_headers.c>
    # Tıklama Korsanlığı (Clickjacking) Koruması
    Header set X-Frame-Options "SAMEORIGIN"
    
    # MIME Türü Sahteciliği (Sniffing) Koruması
    Header set X-Content-Type-Options "nosniff"
    
    # Gizlilik Odaklı Referrer Politikası
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Donanım Yetkilerini Kapat
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"

    # HTML Dosyaları: Asla önbelleğe alma (Değişiklikler anında yansısın)
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # Statik Varlıklar (CSS, SVG, WOFF2, ICO): 1 Hafta Önbellekle
    <FilesMatch "\.(css|svg|woff2|ico)$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>
</IfModule>

# 4. Hassas Dosyalara Doğrudan Erişimi Yasakla (403 Forbidden)
<FilesMatch "(^\.|\.(bak|config|sql|ini|log|sh|py|md)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 5. Özel 404 Sayfası (Alt Dizin Uyumlu)
ErrorDocument 404 /usluy26/404.html
